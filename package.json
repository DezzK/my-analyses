{
  "name": "my-analyses",
  "productName": "Мои анализы",
  "desktopName": "my-analyses.desktop",
  "version": "0.2.4",
  "description": "Family lab results tracker: imports from lab accounts, tables, charts and printable reports",
  "private": true,
  "author": "dezz",
  "license": "UNLICENSED",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm test && npm run build && playwright test",
    "icon": "sips -s format png build/icon.svg --out build/icon.png",
    "release": "node scripts/release.mts tag",
    "release:identity": "node scripts/release-identity.mts"
  },
  "dependencies": {
    "drizzle-orm": "^1.0.0-rc.4",
    "electron-updater": "^6.8.9",
    "node-html-parser": "^9.0.4"
  },
  "devDependencies": {
    "@electron/osx-sign": "^1.3.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@mantine/core": "^9.6.3",
    "@mantine/dates": "^9.6.3",
    "@mantine/form": "^9.6.3",
    "@mantine/hooks": "^9.6.3",
    "@mantine/modals": "^9.6.3",
    "@mantine/notifications": "^9.6.3",
    "@mantine/spotlight": "^9.6.3",
    "@playwright/test": "^1.63.0",
    "@tabler/icons-react": "^3.48.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.40",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "dayjs": "^1.11.23",
    "drizzle-kit": "^1.0.0-rc.4",
    "echarts": "^6.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "postcss": "^8.5.28",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  }
}
